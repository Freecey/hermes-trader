# ── Brave Search ─────────────────────────────────────────────────────────────
# Get your key at https://api.search.brave.com/
BRAVE_API_KEY=BSA...your-key

# ── AI research provider ──────────────────────────────────────────────────────
# Pick ONE provider and set its key. Default: openrouter.
# HERMES_LLM_PROVIDER=openrouter   # openrouter | openai | google | minimax | anthropic

# openrouter — get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...your-key
# OPENROUTER_MODEL=x-ai/grok-4.3            # optional — this is the default

# openai — default model gpt-5.1
# OPENAI_API_KEY=sk-...

# google (Gemini, OpenAI-compat endpoint) — default model gemini-2.5-flash
# GEMINI_API_KEY=...

# minimax — default model MiniMax-M3
# MINIMAX_API_KEY=...

# anthropic (native Messages API via the official SDK) — default claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=...                    # optional — reaches Anthropic-API-
#                                             compatible backends, e.g. MiniMax:
#                                             https://api.minimax.io/anthropic

# Cross-provider overrides (all optional)
# HERMES_LLM_MODEL=...             # model override for any provider
# HERMES_LLM_BASE_URL=...          # custom OpenAI-compatible endpoint
#                                    (e.g. local Ollama/vLLM)
# HERMES_LLM_THINKING=adaptive     # enable model reasoning before the verdict
#                                    (Claude adaptive thinking / MiniMax-M3).
#                                    Off by default — it spends more tokens.
# HERMES_LLM_MAX_TOKENS=4096       # response budget (default 512 — a cost
#                                    optimization; raise on flat-rate/quota
#                                    plans, REQUIRED when thinking is on)

# ── Hyperliquid ───────────────────────────────────────────────────────────────
HYPERLIQUID_WALLET_ADDRESS=0x...your-wallet-address
HYPERLIQUID_PRIVATE_KEY=0x...your-private-key

# Optional: master account (if using agent wallet setup)
# HYPERLIQUID_MASTER_ADDRESS=0x...your-master-address

NEXT_PUBLIC_HL_WALLET=0x...your-wallet-address
# NEXT_PUBLIC_HL_MASTER=0x...your-master-address

# ── Scan tuning (optional — defaults shown) ──────────────────────────────────
# HERMES_SCAN_INTERVAL=60        # seconds between scan cycles
# HERMES_MAX_MARKETS=60          # total candle-fetch budget per scan
# HERMES_MAX_MARKETS_HIP3=25     # of that budget, slots reserved for HIP-3
#                                # (the rest go to native crypto — same total weight)
# HERMES_BATCH_SIZE=20           # markets per parallel batch
# HERMES_BATCH_SLEEP=0.3         # seconds between batches
